{
  "version": 3,
  "name": "payment-gateway-reference",
  "port": 8080,
  "timeout": "30s",
  "cache_ttl": "0s",
  "extra_config": {
    "security/cors": {
      "allow_origins": ["https://dashboard.example.com"],
      "allow_methods": ["GET", "POST", "PUT", "DELETE"],
      "allow_headers": ["Authorization", "Content-Type"]
    }
  },
  "endpoints": [
    {
      "endpoint": "/api/qris/v1/health",
      "method": "GET",
      "backend": [
        {
          "method": "GET",
          "host": ["http://qris-api.payments.svc.cluster.local:3000"],
          "url_pattern": "/health",
          "encoding": "json"
        }
      ],
      "output_encoding": "json",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "https://auth.example.com/application/o/qris-client/jwks/",
          "issuer": "https://auth.example.com/",
          "propagate_claims": [
            ["sub", "X-User-Id"],
            ["preferred_username", "X-User-Name"]
          ]
        }
      },
      "input_headers": ["Authorization", "Content-Type", "X-User-Id", "X-User-Name"]
    },
    {
      "endpoint": "/api/qris/v1/payments",
      "method": "POST",
      "backend": [
        {
          "method": "POST",
          "host": ["http://qris-api.payments.svc.cluster.local:3000"],
          "url_pattern": "/api/v1/partner/payments",
          "encoding": "json"
        }
      ],
      "output_encoding": "json",
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "https://auth.example.com/application/o/qris-client/jwks/",
          "issuer": "https://auth.example.com/"
        }
      },
      "input_headers": ["Authorization", "Content-Type"]
    },
    {
      "endpoint": "/api/qris/v1/payments/{id}",
      "method": "GET",
      "backend": [
        {
          "method": "GET",
          "host": ["http://qris-bank.payments.svc.cluster.local:3001"],
          "url_pattern": "/api/v1/payments/{id}",
          "encoding": "json"
        }
      ],
      "output_encoding": "json"
    }
  ]
}
